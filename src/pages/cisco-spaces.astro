---
import MainLayout from '../layouts/MainLayout.astro';

// Fetch Vimeo thumbnails at build time from the video IDs.
// Falls back to null (neutral tile) if Vimeo's oEmbed is unavailable.
async function vimeoThumb(id: string) {
  try {
    const r = await fetch(`https://vimeo.com/api/oembed.json?url=https%3A%2F%2Fvimeo.com%2F${id}&width=1280`);
    if (!r.ok) return null;
    const d = await r.json();
    return d.thumbnail_url ?? null;
  } catch {
    return null;
  }
}

const heroThumb    = await vimeoThumb('1225612122'); // spaces-hero
const webinarThumb = await vimeoThumb('1225612182'); // spaces-webinar
---

<MainLayout title="Cisco Spaces | Evan Elise">
  <main class="bg-black text-white min-h-screen">
    
