---
// Route = this file's name. Save as src/pages/selected-work.astro
// Serves at www.evanelisegonzalez.com/selected-work
const pdf = "/EG_Full_Portfolio.pdf";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Evan Elise Gonzalez — Selected Work</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        background: #f5f4f0;
        color: #1a1a1a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header { padding: 2rem 1.5rem 1rem; text-align: center; }
      header h1 { font-size: 1.5rem; letter-spacing: -0.01em; }
      header p { margin-top: 0.4rem; opacity: 0.65; font-size: 0.95rem; }
      .actions {
        display: flex; gap: 0.75rem; justify-content: center;
        padding: 0 1.5rem 1.5rem; flex-wrap: wrap;
      }
      .btn {
        padding: 0.7rem 1.5rem; border-radius: 999px;
        text-decoration: none; font-weight: 600; font-size: 0.95rem;
      }
      .btn-primary { background: #1a1a1a; color: #fff; }
      .btn-secondary { background: transparent; color: #1a1a1a; border: 1px solid rgba(0,0,0,0.2); }
      .viewer { flex: 1; width: 100%; max-width: 1000px; margin: 0 auto 2rem; padding: 0 1rem; }
      iframe {
        width: 100%; height: 80vh;
        border: 1px solid rgba(0,0,0,0.12); border-radius: 12px; background: #fff;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Evan Elise Gonzalez</h1>
      <p>Selected work and case studies</p>
    </header>

    <div class="actions">
      <a class="btn btn-primary" href={pdf} download>Download PDF</a>
      <a class="btn btn-secondary" href={pdf} target="_blank" rel="noopener">Open in new tab</a>
    </div>

    <div class="viewer">
      <iframe src={`${pdf}#view=FitH`} title="Evan Elise Gonzalez portfolio"></iframe>
    </div>
  </body>
</html>