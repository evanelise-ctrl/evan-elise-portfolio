---
// Save as src/pages/selected-work.astro
// Serves at www.evanelisegonzalez.com/selected-work
// Adjust the import path below if your layouts folder differs.
import MainLayout from '../layouts/MainLayout.astro';
const pdf = "/EG_Full_Portfolio.pdf";
---
<MainLayout title="Evan Elise Gonzalez — Selected Work" noindex={true}>
  <section style="max-width: 1400px; margin: 0 auto; padding: 60px 50px 100px;">

    <div style="margin-bottom: 40px;">
      <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; opacity: 0.6; font-weight: 900; margin: 0 0 14px;">
        Portfolio
      </p>
      <h1 style="font-weight: 900; text-transform: uppercase; letter-spacing: -0.05em; font-size: clamp(40px, 7vw, 84px); line-height: 0.92; margin: 0;">
        Selected <span style="color: var(--accent);">Work</span>
      </h1>
      <p style="opacity: 0.6; margin: 18px 0 0; max-width: 520px; font-size: 15px; line-height: 1.6;">
        A curated PDF of recent projects and case studies. View it below, download it, or open it full screen.
      </p>
    </div>

    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px;">
      <a href={pdf} download
        style="background-color: var(--accent); color: black; padding: 12px 28px; border-radius: 99px; font-weight: 900; text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; text-decoration: none;">
        Download PDF
      </a>
      <a href={pdf} target="_blank" rel="noopener"
        style="border: 1px solid rgba(255,255,255,0.2); color: white; padding: 12px 28px; border-radius: 99px; font-weight: 900; text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; text-decoration: none;">
        Open in new tab
      </a>
    </div>

    <iframe
      src={`${pdf}#view=FitH`}
      title="Evan Elise Gonzalez portfolio"
      style="width: 100%; height: 80vh; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; background: #fff;">
    </iframe>

    <div style="margin-top: 48px; padding-top: 40px; border-top: 1px solid rgba(255,255,255,0.1); text-align: center;">
      <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; opacity: 0.6; font-weight: 900; margin: 0 0 16px;">
        Want to see more?
      </p>
      <a href="/#featured-work"
        style="display: inline-block; background-color: var(--accent); color: black; padding: 14px 32px; border-radius: 99px; font-weight: 900; text-transform: uppercase; font-size: 13px; letter-spacing: 0.1em; text-decoration: none;">
        View more of my work →
      </a>
    </div>

  </section>
</MainLayout>