---
import MainLayout from '../layouts/MainLayout.astro';
const pdf = "/casestudy.pdf";

const caseStudies = [
  { title: 'Talent Garden Customer Case Study', url: 'https://www.youtube.com/watch?v=Ux9AmnbUaiA' },
  { title: 'Sunrise',                           url: 'https://www.youtube.com/watch?v=L2V9jXQYKhA' },
  { title: 'STC',                               url: 'https://www.youtube.com/watch?v=6EOsf6Lkgco' },
  { title: 'What is SASE?',                      url: 'https://www.youtube.com/watch?v=rUGvZj3fZD0' },
];
---
<MainLayout title="Evan Elise Gonzalez — Case Study" noindex={true}>
  <section style="max-width: 1400px; margin: 0 auto; padding: 60px 50px 100px;">

    <div style="margin-bottom: 40px;">
      <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; opacity: 0.6; font-weight: 900; margin: 0 0 14px;">
        Case Study
      </p>
      <h1 style="font-weight: 900; text-transform: uppercase; letter-spacing: -0.05em; font-size: clamp(40px, 7vw, 84px); line-height: 0.92; margin: 0;">
        Case <span style="color: var(--accent);">Study</span>
      </h1>
      <p style="opacity: 0.6; margin: 18px 0 0; max-width: 520px; font-size: 15px; line-height: 1.6;">
        A detailed case study. View it below, download it, or open it full screen.
      </p>
    </div>

    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px;">
      <a href={pdf} download
        style="background-color: var(--accent); color: black; padding: 12px 28px; border-radius: 99px; font-weight: 900; text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; text-decoration: none;">
        Download PDF
      </a>
      <a href={pdf} target="_blank" rel="noopener"
        style="border: 1px solid rgba(255,255,255,0.2); color: white; padding: 12px 28px; border-radius: 99px; font-weight: 900; text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; text-decoration: none;">
        Open in new tab
      </a>
    </div>

    <iframe
      src={`${pdf}#view=FitH`}
      title="Evan Elise Gonzalez case study"
      style="width: 100%; height: 80vh; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; background: #fff;">
    </iframe>

    <div style="margin-top: 48px; padding-top: 40px; border-top: 1px solid rgba(255,255,255,0.1);">
      <p style="text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; opacity: 0.6; font-weight: 900; margin: 0 0 20px; text-align: center;">
        Customer Case Studies
      </p>
      <div style="display: flex; flex-direction: column; gap: 12px; max-width: 640px; margin: 0 auto;">
        {caseStudies.map((cs) => (
          <a href={cs.url} target="_blank" rel="noopener"
            style="display: flex; justify-content: space-between; align-items: center; gap: 16px; border: 1px solid rgba(255,255,255,0.2); color: white; padding: 16px 24px; border-radius: 12px; font-weight: 900; text-transform: uppercase; font-size: 13px; letter-spacing: 0.05em; text-decoration: none;">
            <span>{cs.title}</span>
            <span style="color: var(--accent); white-space: nowrap;">Watch →</span>
          </a>
        ))}
      </div>
    </div>

  </section>
</MainLayout>