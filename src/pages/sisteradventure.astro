      cb.type = "checkbox"; cb.checked = checked;
      cb.addEventListener("change", function(){
        state.checked[item] = cb.checked; save(state); render();
      });
      var span = document.createElement("span");
      span.textContent = item;
      label.appendChild(cb); label.appendChild(span);
      listEl.appendChild(label);
    });
    progEl.innerHTML = "<b>" + done + " of " + items.length + " packed.</b> Saved in this browser, so the list remembers between visits.";
  }
  document.getElementById("packAddBtn").addEventListener("click", function(){
    var inp = document.getElementById("packInput");
    var v = inp.value.trim();
    if (v && state.custom.indexOf(v) === -1 && DEFAULTS.indexOf(v) === -1){
      state.custom.push(v); save(state); render();
    }
    inp.value = "";
  });
  document.getElementById("packInput").addEventListener("keydown", function(e){
    if (e.key === "Enter") document.getElementById("packAddBtn").click();
  });
  document.getElementById("packReset").addEventListener("click", function(){
    if (confirm("Clear all checks and custom items?")){ state = {checked:{}, custom:[]}; save(state); render(); }
  });
  render();
})();
</script>
</body>
</html>