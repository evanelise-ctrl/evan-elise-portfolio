---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

const { title, noindex = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<Analytics />
	</head>

	<body class="bg-black text-white antialiased">
		<nav style="position: fixed; top: 0; left: 0; width: 100%; height: 80px; background-color: black; border-bottom: 1px solid rgba(255,255,255,0.1); z-index: 1000; display: flex; align-items: center;">
			<div style="width: 100%; max-width: 1400px; margin: 0 auto; padding: 0 50px; display: flex; justify-content: space-between; align-items: center;">
				<a href="/" style="font-weight: 900; text-transform: uppercase; letter-spacing: -0.05em; font-size: 20px; color: white; text-decoration: none;">
					EVAN <span style="color: var(--accent);">ELISE</span> GONZALEZ
				</a>

				<div style="display: flex; gap: 20px; align-items: center;">
					<a href="/#featured-work" style="color: white; text-decoration: none; font-weight: 900; text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; opacity: 0.6; transition: opacity 0.3s;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.6'">
						Work
					</a>
					<a href="/" style="background-color: var(--accent); color: black; padding: 8px 20px; border-radius: 99px; font-weight: 900; text-transform: uppercase; font-size: 12px; letter-spacing: 0.1em; text-decoration: none;">
						Home
					</a>
				</div>
			</div>
		</nav>

		<div style="margin-top: 80px;">
			<slot />
		</div>
	</body>
</html>