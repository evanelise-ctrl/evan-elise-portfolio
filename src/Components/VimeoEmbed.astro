---
interface Props {
  id: string;
  title: string;
  ratio?: "16:9" | "4:3";
}
const { id, title, ratio = "16:9" } = Astro.props;
const padding = ratio === "4:3" ? "75%" : "56.25%";
const src = `https://player.vimeo.com/video/${id}?title=0&byline=0&portrait=0&badge=0&autopause=0&player_id=0&app_id=58479`;
---
<div class="vimeo-embed" style={`padding:${padding} 0 0 0;position:relative;`}>
  <iframe
    src={src}
    loading="lazy"
    frameborder="0"
    allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
    referrerpolicy="strict-origin-when-cross-origin"
    style="position:absolute;top:0;left:0;width:100%;height:100%;"
    title={title}
  ></iframe>
</div>

<script is:inline>
  // loads the Vimeo player API once per page, only if any embed is present
  if (!window.__vimeoPlayerLoaded) {
    window.__vimeoPlayerLoaded = true;
    const s = document.createElement("script");
    s.src = "https://player.vimeo.com/api/player.js";
    document.head.appendChild(s);
  }
</script>